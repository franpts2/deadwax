{
	"name": "deadwax",
	"private": true,
	"version": "0.1.0",
	"description": "A three-dimensional shelf of records built with React, three.js and Tailwind CSS.",
	"license": "MIT",
	"author": "Francisca Portugal",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/franpts2/deadwax.git"
	},
	"bugs": {
		"url": "https://github.com/franpts2/deadwax/issues"
	},
	"homepage": "https://github.com/franpts2/deadwax#readme",
	"keywords": [
		"three.js",
		"react-three-fiber",
